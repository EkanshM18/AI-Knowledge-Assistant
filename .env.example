# App
APP_NAME=Enterprise AI Knowledge Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=google/flan-t5-base
LLM_DEVICE=cpu
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.1

# Qdrant
QDRANT_PATH=qdrant_data
QDRANT_COLLECTION=enterprise_knowledge

# Local runtime paths
DATA_DIR=data
PIPELINE_CACHE_DIR=data/pipeline_cache

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@db.kngnlupzcouustnrksrp.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=enterprise-documents
SUPABASE_DOCUMENTS_TABLE=documents

# Ingestion / retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4
MAX_CONTEXT_CHARACTERS=5000
HTTP_TIMEOUT_SECONDS=10

# Frontend CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional news tool sources
NEWS_FEED_URLS=https://feeds.npr.org/1001/rss.xml,https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.bbci.co.uk/news/technology/rss.xml
